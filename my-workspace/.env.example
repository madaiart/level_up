# Copy to .env and adjust. Nx loads this file into every task (serve, db:migrate, ...).

# Used by docker-compose.yml to initialise the Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=level_up
POSTGRES_PORT=5432

# Used by the API (postgres.js) and dbmate. sslmode=disable because the local
# container has no TLS (dbmate's driver requires SSL unless told otherwise).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/level_up?sslmode=disable
DATABASE_POOL_MAX=10
