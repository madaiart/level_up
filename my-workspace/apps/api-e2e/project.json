{
  "name": "api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "api"
  ],
  "targets": {
    "e2e": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}"
      ],
      "dependsOn": [
        "api:build",
        "api:serve"
      ],
      "options": {
        "configFile": "apps/api-e2e/vitest.config.mts"
      }
    }
  }
}
