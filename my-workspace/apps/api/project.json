{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "vp pack",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/api",
        "commands": [
          "vp pack --watch --no-clean",
          "node --watch ../../dist/apps/api/main.mjs"
        ],
        "env": {
          "NODE_ENV": "development"
        }
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        },
        "production": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/apps/api"],
      "options": {
        "command": "vp test",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vp lint",
        "cwd": "apps/api"
      }
    },
    "db:up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d --wait postgres",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose down",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:new": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dbmate --migrations-dir ./db/migrations --schema-file ./db/schema.sql --no-dump-schema new {args.name}",
        "cwd": "apps/api"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dbmate --migrations-dir ./db/migrations --schema-file ./db/schema.sql --no-dump-schema --wait migrate",
        "cwd": "apps/api"
      }
    },
    "db:rollback": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dbmate --migrations-dir ./db/migrations --schema-file ./db/schema.sql --no-dump-schema rollback",
        "cwd": "apps/api"
      }
    },
    "db:status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dbmate --migrations-dir ./db/migrations --schema-file ./db/schema.sql --no-dump-schema status",
        "cwd": "apps/api"
      }
    },
    "db:dump": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose exec -T postgres sh -c 'pg_dump --schema-only --no-owner --no-privileges --restrict-key=dbmate -U \"$POSTGRES_USER\" \"$POSTGRES_DB\"' > apps/api/db/schema.sql",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
